<script>
/* Per-case presentation clock. All settings and code stay inside this QMD. */
(function () {
  'use strict';
  const budgetMs = 20 * 60 * 1000;
  const warningMs = 2 * 60 * 1000;
  const storageKey = 'aoa-workshop-section-clock-20min-v2';
  let records = {};
  try {
    const saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
    for (const id of ['case-1','case-2','case-3','case-4']) {
      const r = saved[id];
      if (r && Number.isFinite(r.elapsedMs) && r.elapsedMs >= 0 &&
          (r.startedAt === null || Number.isFinite(r.startedAt))) {
        records[id] = {elapsedMs:r.elapsedMs, startedAt:r.startedAt,
          paused:!!r.paused, warned:!!r.warned};
      }
    }
  } catch (_) { /* A private browser may disallow session storage. */ }
  const save = () => { try { sessionStorage.setItem(storageKey, JSON.stringify(records)); } catch (_) {} };
  const elapsed = r => r.elapsedMs + (r.startedAt === null ? 0 : Math.max(0,Date.now()-r.startedAt));
  const stop = r => { r.elapsedMs = elapsed(r); r.startedAt = null; };

  function startClock() {
    if (window.AOASectionClock) return;
    const reveal = window.Reveal;
    const root = document.createElement('div');
    root.className = 'aoa-section-clock';
    root.hidden = true;
    root.innerHTML = '<button type="button" class="aoa-clock-indicator" aria-expanded="false" aria-controls="aoa-clock-controls"><span class="aoa-clock-dot" aria-hidden="true"></span><span class="aoa-clock-label"></span></button><div id="aoa-clock-controls" class="aoa-clock-controls" hidden><div class="aoa-clock-detail"></div><div class="aoa-clock-actions"><button type="button" class="aoa-clock-pause">Pause</button><button type="button" class="aoa-clock-reset">Reset section</button></div></div><span class="aoa-clock-announcement" role="status" aria-live="polite"></span>';
    (document.querySelector('.reveal') || document.body).appendChild(root);
    const indicator = root.querySelector('.aoa-clock-indicator');
    const label = root.querySelector('.aoa-clock-label');
    const panel = root.querySelector('.aoa-clock-controls');
    const pauseButton = root.querySelector('.aoa-clock-pause');
    const detail = root.querySelector('.aoa-clock-detail');
    const announce = root.querySelector('.aoa-clock-announcement');
    let active = null;
    let lastAnnouncement = '';

    function state() {
      if (!active) return null;
      const r = records[active], ms = elapsed(r);
      return {section:active,elapsedMs:ms,remainingMs:budgetMs-ms,
        paused:r.paused,color:ms>=budgetMs?'red':ms>=budgetMs-warningMs?'yellow':'green'};
    }
    function paint() {
      const s = state();
      root.hidden = !s;
      if (!s) return;
      root.dataset.color = s.color;
      root.dataset.paused = String(s.paused);
      const name = 'CASE ' + s.section.slice(-1).padStart(2,'0');
      label.textContent = name + (s.paused ? ' · PAUSED' : '');
      const message = s.color==='red'?'Time reached':s.color==='yellow'?'Two-minute warning':'Within time';
      indicator.title = name+' — '+message+'. Click for pause and reset.';
      indicator.setAttribute('aria-label',name+', '+message+(s.paused?', paused':'')+'. Timer controls');
      const remain = Math.abs(Math.ceil(s.remainingMs/1000));
      const time = Math.floor(remain/60)+':'+String(remain%60).padStart(2,'0');
      detail.textContent = time+(s.remainingMs<0?' over':' remaining')+' · 20-minute section';
      pauseButton.textContent = s.paused?'Resume':'Pause';
      const nextAnnouncement = name+': '+message+(s.paused?' — paused':'');
      if (nextAnnouncement!==lastAnnouncement) {
        announce.textContent = nextAnnouncement;
        lastAnnouncement = nextAnnouncement;
      }
      const r = records[active];
      if (s.color==='yellow' && !r.warned) {
        r.warned = true;
        root.classList.remove('aoa-clock-warning');
        void root.offsetWidth;
        root.classList.add('aoa-clock-warning');
        save();
      }
      if (s.color!=='yellow') root.classList.remove('aoa-clock-warning');
    }
    function changeSection() {
      const slide = reveal.getCurrentSlide();
      const next = slide ? slide.getAttribute('data-aoa-section') : null;
      if (next===active) { paint(); return; }
      if (active) stop(records[active]);
      // Stop any stored clock from an earlier page load before changing cases.
      for (const [id,r] of Object.entries(records)) if (id!==next && r.startedAt!==null) stop(r);
      active = next && /^case-[1-4]$/.test(next) ? next : null;
      if (active) {
        const r = records[active] || (records[active]={elapsedMs:0,startedAt:null,paused:false,warned:false});
        if (!r.paused && r.startedAt===null) r.startedAt = Date.now();
      }
      panel.hidden = true;
      indicator.setAttribute('aria-expanded','false');
      root.classList.remove('aoa-clock-warning');
      save(); paint();
    }
    function pause() {
      if (!active) return;
      const r=records[active]; stop(r); r.paused=true; save(); paint();
    }
    function resume() {
      if (!active) return;
      const r=records[active];
      if (r.paused) { r.paused=false; r.startedAt=Date.now(); }
      save(); paint();
    }
    function reset() {
      if (!active) return;
      const paused=records[active].paused;
      records[active]={elapsedMs:0,startedAt:paused?null:Date.now(),paused,warned:false};
      root.classList.remove('aoa-clock-warning'); save(); paint();
    }
    root.addEventListener('click', e=>e.stopPropagation());
    root.addEventListener('pointerdown',e=>e.stopPropagation());
    root.addEventListener('keydown',e=>e.stopPropagation());
    indicator.addEventListener('click',()=>{
      panel.hidden=!panel.hidden;
      indicator.setAttribute('aria-expanded',String(!panel.hidden));
      paint();
    });
    pauseButton.addEventListener('click',()=>state().paused?resume():pause());
    root.querySelector('.aoa-clock-reset').addEventListener('click',reset);
    document.addEventListener('click',e=>{
      if (!root.contains(e.target)) { panel.hidden=true; indicator.setAttribute('aria-expanded','false'); }
    });
    window.AOASectionClock=Object.freeze({getState:state,pause,resume,reset,refresh:paint});
    reveal.on('slidechanged',changeSection);
    window.addEventListener('pagehide',save);
    changeSection();
    window.setInterval(paint,500);
  }
  (function attach() {
    if (!window.Reveal) { window.setTimeout(attach,40); return; }
    if (window.Reveal.isReady()) startClock();
    else window.Reveal.on('ready',startClock);
  })();
})();

</script>
