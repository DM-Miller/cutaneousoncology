# Native Reveal survey layers: question -> all choices -> all results.
# Reads the same survey object and builder code used by the existing figures.
# Does not contact Netlify or change survey records.

.aoa_animation <- new.env(parent = emptyenv())

aoa_html <- function(x) {
  x <- as.character(x)
  x <- gsub("&", "&amp;", x, fixed = TRUE)
  x <- gsub("<", "&lt;", x, fixed = TRUE)
  x <- gsub(">", "&gt;", x, fixed = TRUE)
  x <- gsub('"', "&quot;", x, fixed = TRUE)
  x
}

aoa_survey_init <- function(presentation_dir = getwd()) {
  if (!requireNamespace("jsonlite", quietly = TRUE)) stop("The animated survey renderer requires jsonlite.")
  .aoa_animation$questions <- jsonlite::fromJSON(aoa_question_json, simplifyVector = FALSE)
  caller <- parent.frame()
  builder <- get0("build_icmje_summary", envir = caller, inherits = TRUE)
  context <- if (is.function(builder)) environment(builder) else NULL
  if (is.null(context) || !exists("survey", envir = context, inherits = FALSE)) {
    context <- new.env(parent = caller)
    old <- options(aoa.autobuild = FALSE, aoa.presentation_dir = presentation_dir)
    on.exit(options(old), add = TRUE)
    sys.source(file.path(presentation_dir, "scripts", "build_workshop_figures.R"), envir = context)
  }
  if (!exists("survey", envir = context, inherits = FALSE) || !is.data.frame(context$survey)) {
    stop("Could not obtain the survey cohort from the existing workshop figure builder.")
  }
  # A cohort-size mismatch must be investigated rather than silently showing
  # data from a different population than the existing refreshed figures.
  refreshed <- get0("AOA_SURVEY", envir = caller, inherits = TRUE)
  if (is.list(refreshed) && !is.null(refreshed$n_label)) {
    label <- as.character(refreshed$n_label)[1L]
    match <- regmatches(label, regexpr("[0-9]+", label))
    expected <- suppressWarnings(as.integer(match))
    if (length(expected) && !is.na(expected) && expected != nrow(context$survey)) {
      stop("Animated survey cohort (", nrow(context$survey), ") differs from the refreshed survey (", expected, "). Check the existing production-mode cohort before rendering.")
    }
  }
  .aoa_animation$survey <- context$survey
  .aoa_animation$min_n <- max(5L, as.integer(getOption("aoa.minimum_n", 5L)))
  invisible(TRUE)
}

aoa_question_data <- function(id) {
  q <- .aoa_animation$questions[[id]]
  if (is.null(q)) stop("Unknown workshop survey question: ", id)
  dat <- .aoa_animation$survey
  raw <- if (id %in% names(dat)) trimws(as.character(dat[[id]])) else character()
  raw <- raw[!is.na(raw) & nzchar(raw)]
  options <- q$options
  codes <- vapply(options, function(o) as.character(o$value), character(1))
  # Support plain-text and JSON-array serializations without changing the
  # question's denominator. Ranked results use the first-ranked response.
  split_response <- function(s) {
    if (grepl("^\\s*\\[", s)) {
      return(as.character(jsonlite::fromJSON(s)))
    }
    trimws(strsplit(s, "\\s*[|;,]\\s*")[[1L]])
  }
  answers <- lapply(raw, split_response)
  if (identical(q$type, "rank")) answers <- lapply(answers, function(z) head(z[nzchar(z)],1L))
  if (!identical(q$type, "multi") && !identical(q$type, "rank")) answers <- lapply(raw, function(z) z)
  answers <- lapply(answers, unique)
  extra <- setdiff(unique(unlist(answers, use.names = FALSE)), codes)
  if (length(extra)) {
    warning("Additional answer codes in ", id, ": ", paste(extra, collapse = ", "), ". They are retained in the distribution.", call. = FALSE)
    options <- c(options, lapply(extra, function(z) list(value = z, label = z, display = gsub("_"," ",z))))
    codes <- c(codes,extra)
  }
  n <- length(answers)
  counts <- vapply(codes, function(code) sum(vapply(answers, function(a) code %in% a, logical(1))), integer(1))
  pct <- if (n) round(100 * counts / n) else rep(NA_real_,length(counts))
  list(question = q, options = options, codes = codes, n = n, counts = counts, pct = pct)
}

aoa_survey_slide <- function(id, heading, section) {
  d <- aoa_question_data(id)
  q <- d$question
  ok <- d$n >= .aoa_animation$min_n
  nopts <- length(d$options)
  cols <- if (nopts > 7L) " two-columns" else ""
  answer_rows <- if (nopts > 7L) ceiling(nopts / 2) else nopts
  summary <- NULL
  if (ok && id == "guidelines_icmje_familiarity") {
    summary <- list(pct = round(100 * sum(d$counts[d$codes %in% c("very_familiar","somewhat_familiar")]) / d$n), label = "very / somewhat familiar")
  }
  if (ok && id == "guidelines_use_frequency") {
    summary <- list(pct = round(100 * sum(d$counts[d$codes %in% c("always","often","sometimes","very_often")]) / d$n), label = "use guidance at least sometimes")
  }
  cat('<div class="aoa-shell"><div class="aoa-topbar"><div class="aoa-section-label">',aoa_html(section),'</div><div class="aoa-heading">',aoa_html(heading),'</div></div><div class="aoa-content native-survey-content"><div class="native-survey">',sep="")
  cat('<div class="survey-question">',aoa_html(q$prompt),sep="")
  if (!is.null(q$help) && nzchar(q$help)) cat('<div class="survey-question-help">',aoa_html(q$help),'</div>',sep="")
  cat('</div><div class="survey-answer-area">',sep="")
  if (!is.null(summary)) cat('<div class="survey-with-summary">')
  cat('<div class="survey-choices fragment fade-in',cols,'" data-fragment-index="0" style="--answer-count:',nopts,';--answer-rows:',answer_rows,'">',sep="")
  for (i in seq_along(d$options)) {
    o <- d$options[[i]]
    display <- if (is.null(o$display)) o$label else o$display
    cat('<div class="survey-option" title="',aoa_html(o$label),'"><div class="survey-option-label">',aoa_html(display),'</div><div class="survey-result fragment fade-in" data-fragment-index="1">',sep="")
    if (ok) cat('<span class="survey-pct">',d$pct[[i]],'%</span><span class="survey-count">',d$counts[[i]],'</span>',sep="")
    cat('</div><div class="survey-track"><div class="survey-fill fragment fade-in" data-fragment-index="1" style="width:',if(ok)d$pct[[i]] else 0,'%"></div></div></div>',sep="")
  }
  cat('</div>')
  if (!is.null(summary)) {
    cat('<div class="survey-summary fragment fade-in" data-fragment-index="1"><div class="survey-summary-number">',summary$pct,'%','</div><div class="survey-summary-label">',aoa_html(summary$label),'</div></div></div>',sep="")
  }
  cat('</div><div class="survey-stage-note fragment fade-in" data-fragment-index="1">',sep="")
  if (ok) {
    cat('<strong>n = ',d$n,'</strong> respondents. ',sep="")
    if (identical(q$type,"multi")) cat('Multiple selections permitted; percentages need not total 100%.')
    else if (identical(q$type,"rank")) cat('First-ranked choices; percentages may differ from 100% because of rounding.')
    else cat('Percentages may differ from 100% because of rounding.')
  } else cat('Question-level results display only when n &gt;= ',.aoa_animation$min_n,'.',sep="")
  cat('</div></div></div></div>',sep="")
  aoa_say_notes(aoa_survey_words(id,d))
  invisible(d)
}


# Paired survey panels retain their own wording, options, and denominators.
# Builds: left choices (0), left results (1), right question (2),
# right choices (3), right results (4). Left results stay visible.
aoa_survey_pair <- function(left_id, right_id, heading) {
  pair <- lapply(c(left_id,right_id), aoa_question_data)
  dense <- max(vapply(pair,function(d)length(d$options),integer(1))) > 7L
  cat('<div class="aoa-shell"><div class="aoa-topbar"><div class="aoa-section-label">CASE 03 · TWO PERSPECTIVES</div><div class="aoa-heading">',aoa_html(heading),'</div></div><div class="aoa-content paired-survey-content"><div class="paired-survey',if(dense)' paired-dense' else '','">',sep='')
  for (side in 1:2) {
    d <- pair[[side]]; q <- d$question
    ok <- d$n >= .aoa_animation$min_n
    question_index <- if(side==1) NA_integer_ else 2L
    choice_index <- if(side==1) 0L else 3L
    result_index <- if(side==1) 1L else 4L
    title <- if(side==1)'INVESTIGATOR PERSPECTIVE' else 'INDUSTRY / PUBLICATION-TEAM PERSPECTIVE'
    cat('<div class="paired-panel',if(side==2)' fragment fade-in' else '','"',if(side==2)' data-fragment-index="2"' else '', '><div class="paired-perspective">',title,'</div><div class="paired-question">',aoa_html(q$prompt),'</div>',sep='')
    cat('<div class="paired-answers fragment fade-in" data-fragment-index="',choice_index,'" style="--paired-rows:',length(d$options),'">',sep='')
    for (i in seq_along(d$options)) {
      o <- d$options[[i]]
      display <- if(is.null(o$display))o$label else o$display
      cat('<div class="paired-option" title="',aoa_html(o$label),'"><div class="paired-label">',aoa_html(display),'</div><div class="paired-result fragment fade-in" data-fragment-index="',result_index,'">',sep='')
      if(ok)cat('<span class="paired-pct">',d$pct[[i]],'%</span><span class="paired-count">n=',d$counts[[i]],'</span>',sep='')
      cat('</div><div class="paired-track"><div class="paired-fill fragment fade-in" data-fragment-index="',result_index,'" style="width:',if(ok)d$pct[[i]] else 0,'%"></div></div></div>',sep='')
    }
    cat('</div><div class="paired-denominator fragment fade-in" data-fragment-index="',result_index,'">',sep='')
    if(ok)cat('n = ',d$n,' respondents',sep='') else cat('Results display only when n &gt;= ',.aoa_animation$min_n,sep='')
    cat('</div></div>')
  }
  cat('</div><div class="paired-footnote fragment fade-in" data-fragment-index="4">Separate respondent groups and denominators. ',sep='')
  if(grepl('inclusion_driver',left_id,fixed=TRUE))cat('The prompts and answer lists differ; compare patterns rather than treating these as identical questions. ')
  cat('Percentages may differ from 100% because of rounding.</div></div></div>')
  aoa_say_notes(aoa_pair_words(left_id,pair))
  invisible(pair)
}

