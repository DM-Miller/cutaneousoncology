}

aoa_survey_words <- function(id,d) {
  script<-aoa_speaking_scripts()$surveys[[id]]
  if(is.null(script))script<-list(d$question$prompt,'What would you expect the group’s responses to look like?','What stands out to you in that distribution?')
  c(script[1:2],list(paste(aoa_result_words(d),script[[3]])))
}

aoa_pair_words <- function(left_id,pair) {
  script<-aoa_speaking_scripts()$pairs[[left_id]]
  if(is.null(script))stop('Missing spoken script for paired survey: ',left_id)
  c(script[1:2],list(aoa_result_words(pair[[1]],'investigator')),script[3:4],
    list(paste(aoa_result_words(pair[[2]],'industry'),script[[5]])))
}


