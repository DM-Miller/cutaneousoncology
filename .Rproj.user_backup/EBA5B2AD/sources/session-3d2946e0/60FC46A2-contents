aoa_speaking_scripts <- function() {
  if (is.null(.aoa_animation$spoken)) {
    .aoa_animation$spoken <- jsonlite::fromJSON(aoa_speaking_json, simplifyVector=FALSE)
  }
  .aoa_animation$spoken
}

aoa_result_words <- function(d, group=NULL) {
  if(d$n < .aoa_animation$min_n) {
    return(paste0(if(is.null(group))'We do not have' else paste0('For ',group,', we do not have'),
      ' enough responses to display this distribution. We can still discuss the question together.'))
  }
  lead <- if(is.null(group))paste0('Among the ',d$n,' people who answered, ') else paste0('Among the ',d$n,' ',group,' respondents, ')
  if(identical(d$question$id,'guidelines_icmje_familiarity')) {
    combined<-round(100*sum(d$counts[d$codes %in% c('very_familiar','somewhat_familiar')])/d$n)
    very<-round(100*sum(d$counts[d$codes=='very_familiar'])/d$n)
    return(paste0(lead,combined,' percent were very or somewhat familiar. ',very,' percent were very familiar.'))
  }
  if(identical(d$question$id,'guidelines_use_frequency')) {
    combined<-round(100*sum(d$counts[d$codes %in% c('always','often','sometimes','very_often')])/d$n)
    return(paste0(lead,combined,' percent reported using formal guidance at least sometimes. The individual categories show how regularly it enters their decisions.'))
  }
  top<-which(d$counts==max(d$counts))
  labels<-vapply(d$options,function(o)if(is.null(o$display))o$label else o$display,character(1))
  if(length(top)==length(d$counts)) return(paste0(lead,'the responses were evenly distributed across the choices.'))
  if(length(top)>2L) return(paste0(lead,'several choices tied for the largest share, at ',d$pct[top[1]],' percent each.'))
  quoted<-paste0('“',labels[top],'”')
  if(length(top)==2L) return(paste0(lead,quoted[1],' and ',quoted[2],' were tied at ',d$pct[top[1]],' percent each.'))
  type<-if(identical(d$question$type,'multi'))'the most selected option was ' else if(identical(d$question$type,'rank'))'the most frequent first-ranked choice was ' else 'the most frequent response was '
  paste0(lead,type,quoted,', at ',d$pct[top],' percent.')
}

aoa_say_notes <- function(paragraphs) {
