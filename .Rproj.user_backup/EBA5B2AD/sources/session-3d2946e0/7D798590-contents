<style>
/* SoCO · The Art of Authorship
   Presentation layout, 1600 × 900. Replace the earlier stylesheet in full.
   Shared canvas -> typography -> layouts -> figures -> title/dividers.
   Figure placement is controlled here; no inline positioning is required. */

:root {
  --aoa-navy: #041b33;
  --aoa-blue: #06436e;
  --aoa-teal: #0f7f86;
  --aoa-teal-deep: #08636a;
  --aoa-aqua: #70c4c5;
  --aoa-coral: #ff3b3f;
  --aoa-coral-deep: #c8333d;
  --aoa-ink: #18293d;
  --aoa-muted: #526579;
  --aoa-border: #dbe8ee;
  --aoa-surface: #f6fafb;
  --aoa-surface-2: #eef7f8;
  --aoa-surface-3: #f9fcfd;
  --aoa-teal-wash: #eaf5f5;
  --aoa-coral-wash: #fff3f3;
  --aoa-white: #fff;
  --aoa-gutter: 64px;
  --aoa-gap: 26px;
  --aoa-radius: 16px;
  --aoa-shadow: 0 5px 18px rgba(4,27,51,.035);
}

.reveal {
  background: var(--aoa-surface);
  color: var(--aoa-ink);
  font-family: "Avenir Next", "Aptos", "Segoe UI", Arial, sans-serif;
  font-size: 25px;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
}
.reveal .slides { text-align: left; }
.reveal .slides section.aoa-slide {
  width: 1600px !important;
  height: 900px !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden;
  background: var(--aoa-surface);
  box-sizing: border-box;
}
.aoa-slide *, .aoa-slide *::before, .aoa-slide *::after {
  box-sizing: border-box;
}
/* Keep real headings in the source for navigation and accessibility. */
.reveal .slides section.aoa-slide > h1,
.reveal .slides section.aoa-slide > h2,
.reveal .slides section.aoa-slide > h3 { display: none; }
.reveal .aoa-slide p {
  margin: 0;
  font-size: inherit;
  line-height: inherit;
  font-weight: inherit;
  letter-spacing: inherit;
}
.reveal .aoa-slide strong { font-weight: 750; }
.reveal .aoa-slide a { color: var(--aoa-teal-deep); }
.reveal .aoa-slide img { margin: 0; }
.reveal .controls { color: var(--aoa-teal); }
.reveal .progress, .reveal .slide-number { display: none !important; }
.reveal .footer {
  left: var(--aoa-gutter) !important;
  right: var(--aoa-gutter) !important;
  width: auto !important;
  bottom: 19px !important;
